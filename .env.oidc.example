# OIDC provider (for example ZITADEL, Keycloak, Authentik, or another OIDC provider)
OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=https://pandaplan.example.com/oidc/callback

# Redirect after the OIDC provider session has been logged out.
OIDC_POST_LOGOUT_REDIRECT_URI=/oidc

# Secret used to sign the standalone OIDC session cookie
OIDC_SESSION_SECRET=replace-with-a-long-random-secret
